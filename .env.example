# Configuración de Entorno y Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FILE_PATH=logs/jessyca_mcp.log

# Configuración del Servidor MCP
MCP_SERVER_NAME=jessyca-windows-mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Integración con Windows 10/11
ENABLE_WINDOWS_NOTIFICATIONS=true
STRICT_WINDOWS_ADMIN_CHECK=false

# Cerebro LLM Local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Proveedor Experimental Remoto — NVIDIA Nemotron 3 Ultra (Desactivado por defecto)
NEMOTRON_ENABLED=false
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_TIMEOUT_SECONDS=30.0

# Router Inteligente Experimental (Fase 4: static, shadow [default], experimental)
MODEL_ROUTER_MODE=shadow
ROUTER_CONFIDENCE_THRESHOLD=0.80

