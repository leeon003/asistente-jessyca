# Configuración de Entorno y Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
# LOG_FILE_PATH=logs/jessyca_mcp.log

# Configuración del Servidor MCP
MCP_SERVER_NAME=jessyca-windows-mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000

# Integración con Windows 10/11
ENABLE_WINDOWS_NOTIFICATIONS=true
STRICT_WINDOWS_ADMIN_CHECK=false

# Cerebro LLM Local
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Proveedor Experimental Remoto — NVIDIA Nemotron 3 Ultra (Desactivado por defecto)
NEMOTRON_ENABLED=false
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NEMOTRON_TIMEOUT_SECONDS=30.0
NEMOTRON_CONNECT_TIMEOUT_SECONDS=5.0
NEMOTRON_MAX_RETRIES=2

# Router Inteligente (Fase 3: static, shadow [default], controlled, experimental)
MODEL_ROUTER_ENABLED=false
MODEL_ROUTER_MODE=shadow
ROUTER_CONFIDENCE_THRESHOLD=0.80
ROUTER_SHADOW_LOG_FILE=logs/router_shadow.jsonl

# Modos de Runtime de Seguridad y Control
JDE_RUNTIME_MODE=CONTROLLED
ARE_RUNTIME_MODE=DISABLED

# Tokens de Autenticación de Bridges (Opcionales, dejar vacíos si no se usan)
MOBILE_API_AUTH_TOKEN=
WEBUI_BRIDGE_AUTH_TOKEN=

# Configuración de Voz y Reconocimiento STT (faster-whisper [local/offline], google [remoto], mock [test])
VOICE_STT_PROVIDER=faster-whisper
VOICE_FASTER_WHISPER_MODEL=base
VOICE_FASTER_WHISPER_DEVICE=auto
VOICE_FASTER_WHISPER_COMPUTE_TYPE=default
VOICE_STT_LANGUAGE=es
VOICE_STT_CONFIDENCE_THRESHOLD=0.50

# Detección de Actividad de Voz (VAD) - Integración I1 Silero VAD (Desactivado por defecto)
VAD_BACKEND=energy
SILERO_VAD_ENABLED=false
# SILERO_VAD_MODEL_PATH=
SILERO_VAD_THRESHOLD=0.50
SILERO_VAD_NEG_THRESHOLD=0.35

# Palabra de Activación (Wake Word) - Integración I5 openWakeWord (Desactivado por defecto)
WAKE_WORD_BACKEND=manual
OPENWAKEWORD_ENABLED=false
# OPENWAKEWORD_MODEL_PATH=models/wakeword/jessyca.onnx
OPENWAKEWORD_THRESHOLD=0.60
OPENWAKEWORD_COOLDOWN_SECONDS=2.0

# Navegación y Automatización Web - Integración I2 Playwright (Desactivado por defecto)
BROWSER_BACKEND=windows
PLAYWRIGHT_ENABLED=false
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CHANNEL=msedge
# PLAYWRIGHT_USER_DATA_DIR=data/browser_profiles/playwright_msedge

# Procesamiento Documental - Integración I3 Docling (Desactivado por defecto)
ANYDOC_BACKEND=anydoc
DOCLING_ENABLED=false
DOCLING_OCR_ENABLED=true
DOCLING_MAX_PAGES=50
DOCLING_TIMEOUT_SECONDS=60.0
DOCLING_CONCURRENCY_LIMIT=1

# Inspección y Automatización UI - Integración I4 pywinauto (Desactivado por defecto)
UI_INSPECTION_BACKEND=uiautomation
PYWINAUTO_ENABLED=false
PYWINAUTO_BACKEND=uia
PYWINAUTO_ACTION_TIMEOUT=5.0



